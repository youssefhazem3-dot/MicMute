<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>Assets\app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>MicMute.App</StartupObject>
    <RootNamespace>MicMute</RootNamespace>
    <AssemblyName>MicMute</AssemblyName>

    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\App.xaml" LogicalName="MicMute.App.xaml" />
    <EmbeddedResource Include="UI\MainWindow.xaml" LogicalName="MicMute.MainWindow.xaml" />
    <EmbeddedResource Include="UI\SettingsWindow.xaml" LogicalName="MicMute.SettingsWindow.xaml" />
    <EmbeddedResource Include="UI\OsdWindow.xaml" LogicalName="MicMute.OsdWindow.xaml" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="MicMute.app.ico" />
    <EmbeddedResource Include="Assets\sounds\mute.wav" LogicalName="MicMute.sounds.mute.wav" />
    <EmbeddedResource Include="Assets\sounds\unmute.wav" LogicalName="MicMute.sounds.unmute.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
