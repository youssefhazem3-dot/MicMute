<Window x:Class="MicMute.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicMute Settings"
        Width="412"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.ClearTypeHint="Auto"
        RenderOptions.EdgeMode="Unspecified"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="False"
        UseLayoutRounding="True"
        FontWeight="Bold">

    <Grid x:Name="settingsScaleHost" HorizontalAlignment="Center">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="settingsLayoutScaleTransform" ScaleX="1.0" ScaleY="1.0" />
        </Grid.LayoutTransform>

        <!-- Outer Settings Window Frame (Apple Liquid Glass Shell) -->
        <Border x:Name="settingsRootBorder"
                Width="412"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1.5"
                CornerRadius="20"
                SnapsToDevicePixels="False"
                RenderOptions.EdgeMode="Unspecified"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="settingsOpenScale" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="settingsOpenTranslate" X="0.0" Y="0.0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid SnapsToDevicePixels="False" RenderOptions.EdgeMode="Unspecified">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Synchronized Theme Transition Snapshot Crossfade Overlay -->
                <Rectangle x:Name="settingsThemeOverlay"
                           Grid.RowSpan="2"
                           Panel.ZIndex="90"
                           IsHitTestVisible="False"
                           Opacity="0.0"
                           Visibility="Collapsed"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           SnapsToDevicePixels="False"
                           RenderOptions.EdgeMode="Unspecified"
                           RadiusX="20" RadiusY="20" />

                <!-- Custom Draggable Title Bar -->
                <Border x:Name="borderSettingsTitleBar"
                        Grid.Row="0"
                        Background="{DynamicResource TitleBarBgBrush}"
                        CornerRadius="20,20,0,0"
                        SnapsToDevicePixels="False"
                        RenderOptions.EdgeMode="Unspecified">
                    <Grid SnapsToDevicePixels="False" RenderOptions.EdgeMode="Unspecified">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <Path Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.67 19.18,11.36 19.14,11.06 L21.16,9.48 C21.34,9.34 21.39,9.08 21.28,8.87 L19.36,5.55 C19.24,5.34 18.99,5.26 18.77,5.34 L16.38,6.3 C15.88,5.92 15.34,5.6 14.75,5.36 L14.39,2.82 C14.36,2.58 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.64,2.58 9.61,2.82 L9.25,5.36 C8.66,5.6 8.12,5.92 7.62,6.3 L5.23,5.34 C5.01,5.26 4.76,5.34 4.64,5.55 L2.72,8.87 C2.61,9.08 2.66,9.34 2.84,9.48 L4.86,11.06 C4.82,11.36 4.8,11.67 4.8,12 C4.8,12.33 4.82,12.64 4.86,12.94 L2.84,14.52 C2.66,14.66 2.61,14.92 2.72,15.13 L4.64,18.45 C4.76,18.66 5.01,18.74 5.23,18.66 L7.62,17.7 C8.12,18.08 8.66,18.4 9.25,18.64 L9.61,21.18 C9.64,21.42 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.42 14.39,21.18 L14.75,18.64 C15.34,18.4 15.88,18.08 16.38,17.7 L18.77,18.66 C18.99,18.74 19.24,18.66 19.36,18.45 L21.28,15.13 C21.39,14.92 21.34,14.66 21.16,14.52 L19.14,12.94 Z M12,15.4 C10.12,15.4 8.6,13.88 8.6,12 C8.6,10.12 10.12,8.6 12,8.6 C13.88,8.6 15.4,10.12 15.4,12 C15.4,13.88 13.88,15.4 12,15.4 Z"
                                  Fill="{DynamicResource TitleTextBrush}"
                                  Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="False"
                                  RenderOptions.EdgeMode="Unspecified"
                                  Margin="0,0,7,0" />
                            <TextBlock Text="Settings"
                                       Foreground="{DynamicResource TitleTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="btnSettingsClose"
                                    Style="{DynamicResource Win11CloseButtonStyle}"
                                    ToolTip="Close Settings (Esc)" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings Body Content -->
                <ScrollViewer Grid.Row="1"
                              x:Name="settingsScrollViewer"
                              Style="{DynamicResource ModernScrollViewerStyle}"
                              Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="14,2,14,14">

                        <!-- GROUP 2: Behaviors & System Settings (iOS Inset Squircle Group) -->
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,10"
                                SnapsToDevicePixels="False"
                                RenderOptions.EdgeMode="Unspecified"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Row 1: On-Screen Display (OSD) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="7"
                                            Background="{DynamicResource SquircleBgBrush}"
                                            BorderBrush="{DynamicResource SquircleBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,9,0"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            VerticalAlignment="Center">
                                        <Path Data="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                                              Stroke="{DynamicResource SquircleIconBrush}"
                                              StrokeThickness="1.5"
                                              Stretch="Uniform"
                                              Width="13" Height="13"
                                              SnapsToDevicePixels="False"
                                              RenderOptions.EdgeMode="Unspecified"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="On-Screen Display (OSD)" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="Visual HUD popup when toggled" Foreground="{DynamicResource TextGrayBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Chunky Liquid Toggle Switch -->
                                    <CheckBox x:Name="cbEnableOsd"
                                              Grid.Column="2"
                                              Style="{DynamicResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- High-Contrast OSD Duration Slider & Placement Sub-Rows -->
                                <Grid x:Name="panelOsdDuration" Margin="37,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Duration" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="sliderOsdDuration"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{DynamicResource ModernSliderStyle}"
                                            Minimum="0.1" Maximum="30.0"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" />
                                    <Border x:Name="borderOsdDurationKeycap"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="58" Height="24"
                                            Background="{DynamicResource KeycapBgBrush}"
                                            BorderBrush="{DynamicResource KeycapBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="8,0,0,0"
                                            Cursor="IBeam"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtOsdDuration"
                                                     Grid.Column="0"
                                                     Width="34"
                                                     MinWidth="32"
                                                     Text="0.3"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource TextWhiteBrush}"
                                                     CaretBrush="{DynamicResource TextWhiteBrush}"
                                                     BorderThickness="0"
                                                     FontSize="10.5"
                                                     FontWeight="Bold"
                                                     TextAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Padding="0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="s"
                                                       Foreground="{DynamicResource TextGrayBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="2,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Row 1: OSD Screen Position Segmented Pill Selector -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Position" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,6,8,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Height="26"
                                            Margin="0,6,0,0"
                                            Padding="2"
                                            Background="{DynamicResource KeycapBgBrush}"
                                            BorderBrush="{DynamicResource KeycapBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            VerticalAlignment="Center">
                                        <Grid x:Name="gridOsdPosition">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Smoothly Gliding Active Pill Indicator -->
                                            <Border x:Name="borderOsdPosPill"
                                                    Grid.ColumnSpan="5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Stretch"
                                                    Background="{DynamicResource MenuBadgeActiveBgBrush}"
                                                    CornerRadius="4"
                                                    IsHitTestVisible="False"
                                                    SnapsToDevicePixels="False"
                                                    RenderOptions.EdgeMode="Unspecified">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="osdPosPillTranslate" X="0" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Button x:Name="btnOsdPosCenter"
                                                    Grid.Column="0"
                                                    Content="Center"
                                                    Tag="Selected"
                                                    Style="{DynamicResource SegmentedPillButtonStyle}"
                                                    ToolTip="Show OSD at the center of the active display" />
                                            <Button x:Name="btnOsdPosBottom"
                                                    Grid.Column="2"
                                                    Content="Bottom"
                                                    Style="{DynamicResource SegmentedPillButtonStyle}"
                                                    ToolTip="Show OSD above the taskbar (clears game crosshairs)" />
                                            <Button x:Name="btnOsdPosTop"
                                                    Grid.Column="4"
                                                    Content="Top"
                                                    Style="{DynamicResource SegmentedPillButtonStyle}"
                                                    ToolTip="Show OSD near the top of the active display" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                                <!-- Row 2: Audio Feedback (Chime) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            Background="{DynamicResource SquircleBgBrush}"
                                            BorderBrush="{DynamicResource SquircleBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                        <Path Data="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                                              Stroke="{DynamicResource SquircleIconBrush}"
                                              StrokeThickness="1.4"
                                              Stretch="Uniform"
                                              SnapsToDevicePixels="False"
                                              RenderOptions.EdgeMode="Unspecified"
                                              Width="13" Height="13"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sound Effects (Audio Chime)" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="Play acoustic sound on mute / unmute" Foreground="{DynamicResource TextGrayBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbSoundFeedback"
                                              Grid.Column="2"
                                              Style="{DynamicResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- High-Contrast Sound Volume / Loudness Slider -->
                                <Grid x:Name="panelSoundVolume" Margin="37,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Volume" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="sliderSoundVolume"
                                            Grid.Column="1"
                                            Style="{DynamicResource ModernSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" />
                                    <Border x:Name="borderSoundVolumeKeycap"
                                            Grid.Column="2"
                                            Width="58" Height="24"
                                            Background="{DynamicResource KeycapBgBrush}"
                                            BorderBrush="{DynamicResource KeycapBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            Margin="8,0,0,0"
                                            Cursor="IBeam"
                                            VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSoundVolume"
                                                     Grid.Column="0"
                                                     Width="34"
                                                     MinWidth="32"
                                                     Text="100"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource TextWhiteBrush}"
                                                     CaretBrush="{DynamicResource TextWhiteBrush}"
                                                     BorderThickness="0"
                                                     FontSize="10.5"
                                                     FontWeight="Bold"
                                                     TextAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Padding="0" />
                                            <TextBlock Grid.Column="1"
                                                       Text=" %"
                                                       Foreground="{DynamicResource TextGrayBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="1,0,0,0" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                                <!-- Row 3: Run on Windows Startup -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            Background="{DynamicResource SquircleBgBrush}"
                                            BorderBrush="{DynamicResource SquircleBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                        <Path Data="M13 10V3L4 14h7v7l9-11h-7z"
                                              Fill="{DynamicResource SquircleIconBrush}"
                                              Stretch="Uniform"
                                              SnapsToDevicePixels="False"
                                              RenderOptions.EdgeMode="Unspecified"
                                              Width="12" Height="13"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Run on Windows Startup" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="Launch automatically with Windows" Foreground="{DynamicResource TextGrayBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbStartup"
                                              Grid.Column="2"
                                              Style="{DynamicResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                                <!-- Row 4: Start Minimized -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            Background="{DynamicResource SquircleBgBrush}"
                                            BorderBrush="{DynamicResource SquircleBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                        <Path Data="M19 13l-7 7-7-7m14-8l-7 7-7-7"
                                              Stroke="{DynamicResource SquircleIconBrush}"
                                              StrokeThickness="1.5"
                                              Stretch="Uniform"
                                              SnapsToDevicePixels="False"
                                              RenderOptions.EdgeMode="Unspecified"
                                              Width="12" Height="12"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Start Minimized" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="Always hide main window to tray" Foreground="{DynamicResource TextGrayBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbStartMinimized"
                                              Grid.Column="2"
                                              Style="{DynamicResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                                <!-- Row 5: Run as Administrator -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            Background="{DynamicResource SquircleBgBrush}"
                                            BorderBrush="{DynamicResource SquircleBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                        <Path Data="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                              Stroke="{DynamicResource SquircleIconBrush}"
                                              StrokeThickness="1.4"
                                              Stretch="Uniform"
                                              SnapsToDevicePixels="False"
                                              RenderOptions.EdgeMode="Unspecified"
                                              Width="13" Height="13"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Run as Administrator" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="Enables hotkeys over anti-cheat and elevated windows"
                                                   Foreground="{DynamicResource TextGrayBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbRunAsAdmin"
                                              Grid.Column="2"
                                              Style="{DynamicResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GROUP 3: Settings Location & Data (iOS Inset Squircle Group) -->
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,10"
                                SnapsToDevicePixels="False"
                                RenderOptions.EdgeMode="Unspecified"
                                Margin="0">
                            <StackPanel>
                                <!-- Row 1: Header with Label and Icon -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="7"
                                            SnapsToDevicePixels="False"
                                            RenderOptions.EdgeMode="Unspecified"
                                            Background="{DynamicResource SquircleBgBrush}"
                                            BorderBrush="{DynamicResource SquircleBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                              Fill="{DynamicResource SquircleIconBrush}"
                                              Stretch="Uniform"
                                              SnapsToDevicePixels="False"
                                              RenderOptions.EdgeMode="Unspecified"
                                              Width="13" Height="11"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Settings Location"
                                                   Foreground="{DynamicResource TextWhiteBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Configuration file and data directory"
                                                   Foreground="{DynamicResource TextGrayBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: 3 Action Buttons in an evenly spaced horizontal row under the text -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="btnOpenFolder" Content="Open"
                                            Style="{DynamicResource SecondaryActionButtonStyle}"
                                            Height="26" FontSize="10.5" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" x:Name="btnChangeFolder" Content="Change"
                                            Style="{DynamicResource SecondaryActionButtonStyle}"
                                            Height="26" FontSize="10.5" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="4" x:Name="btnResetData" Content="Reset"
                                            Style="{DynamicResource SecondaryActionButtonStyle}"
                                            Height="26" FontSize="10.5" HorizontalAlignment="Stretch" />
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,10,0,8" />

                                <!-- Row 3: Inset Glass Pill for Full Path Display -->
                                <Border Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="False"
                                        RenderOptions.EdgeMode="Unspecified"
                                        Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="tbStoragePath"
                                                   Text="%APPDATA%\MicMute"
                                                   Foreground="{DynamicResource TextGrayBrush}"
                                                   FontSize="10"
                                                   FontFamily="Consolas, SF Mono, Cascadia Mono, Segoe UI Mono, monospace"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- In-Window Liquid Glass Confirmation Modal Overlay (for Reset / Admin confirmation inside Settings) -->
                <Border x:Name="borderSettingsModalOverlay"
                        Grid.RowSpan="2"
                        Panel.ZIndex="100"
                        Background="{DynamicResource ModalScrimBrush}"
                        CornerRadius="20"
                        Visibility="Collapsed"
                        Opacity="0"
                        SnapsToDevicePixels="False"
                        RenderOptions.EdgeMode="Unspecified">
                    <Border x:Name="borderSettingsModalCard"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="324"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="False"
                            RenderOptions.EdgeMode="Unspecified">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="settingsModalCardScale" ScaleX="0.96" ScaleY="0.96" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border Background="{DynamicResource ModalCardBgBrush}"
                                    CornerRadius="16"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.40" Color="#000000" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{DynamicResource ModalCardBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    SnapsToDevicePixels="False"
                                    RenderOptions.EdgeMode="Unspecified">
                                <Grid>
                                    <Border Height="1"
                                            VerticalAlignment="Top"
                                            Margin="14,0,14,0"
                                            Background="{DynamicResource ModalTopHighlightBrush}"
                                            IsHitTestVisible="False" />
                                    <StackPanel Margin="18,16">
                                        <TextBlock x:Name="tbSettingsModalTitle"
                                                   Text="Confirm Action"
                                                   Foreground="{DynamicResource TextWhiteBrush}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6" />
                                        <TextBlock x:Name="tbSettingsModalMessage"
                                                   Text="Are you sure?"
                                                   Foreground="{DynamicResource TextGrayBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"
                                                   Margin="0,0,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnSettingsModalCancel"
                                                    Grid.Column="0"
                                                    Height="32"
                                                    Content="Cancel"
                                                    FontSize="11.5"
                                                    Style="{DynamicResource SecondaryActionButtonStyle}" />
                                            <Button x:Name="btnSettingsModalConfirm"
                                                    Grid.Column="2"
                                                    Height="32"
                                                    Content="Confirm"
                                                    FontSize="11.5"
                                                    Style="{DynamicResource SecondaryActionButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
