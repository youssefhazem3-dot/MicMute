<Window x:Class="MicMute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Mute"
        Width="412"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="SF Pro Display, SF Pro Text, SF Pro, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ========================================== -->
        <!-- Dynamic Theme Brushes (Apple Liquid Glass) -->
        <!-- ========================================== -->
        <Color x:Key="AccentColor">#FFFFFF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#22FFFFFF" />

        <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F218181B" Offset="0.0" />
            <GradientStop Color="#F209090B" Offset="1.0" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBgBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#18181B" />
        <SolidColorBrush x:Key="TitleBarBgBrush" Color="#00000000" />
        <SolidColorBrush x:Key="TitleTextBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextGrayBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#71717A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />

        <!-- Liquid Switch Brushes (Soft Silver-White in Dark Mode, Soft Graphite in Light Mode) -->
        <SolidColorBrush x:Key="ToggleOnBrush" Color="#B8C0CC" />
        <SolidColorBrush x:Key="ToggleOnBorderBrush" Color="#B8C0CC" />
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#1C1C1F" />
        <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="ToggleKnobBrush" Color="#E4E4E7" />
        <SolidColorBrush x:Key="ToggleKnobBorderBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="ToggleKnobActiveBrush" Color="#18181B" />
        <SolidColorBrush x:Key="ToggleKnobActiveBorderBrush" Color="#27272A" />

        <!-- Liquid Slider Brushes -->
        <SolidColorBrush x:Key="SliderTrackBrush" Color="#B8C0CC" />
        <SolidColorBrush x:Key="SliderTrackEmptyBrush" Color="#27272A" />
        <SolidColorBrush x:Key="SliderTrackBorderBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="SliderThumbBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#18181B" />

        <!-- Jewel-Cut Outer Ring for Mute Button -->
        <LinearGradientBrush x:Key="JewelRingBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22FFFFFF" Offset="0.0" />
            <GradientStop Color="#05FFFFFF" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="JewelRingBorderBrush" Color="#3DFFFFFF" />

        <!-- Liquid Hero Mute Button Brushes -->
        <RadialGradientBrush x:Key="HeroLensActiveBrush" Center="0.35,0.30" GradientOrigin="0.35,0.30" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#FFFFFFFF" Offset="0.0" />
            <GradientStop Color="#FFE4E4E7" Offset="0.45" />
            <GradientStop Color="#FFD4D4D8" Offset="0.85" />
            <GradientStop Color="#FFA1A1AA" Offset="1.0" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="HeroGlowActiveBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#80FFFFFF" Offset="0.0" />
            <GradientStop Color="#00FFFFFF" Offset="1.0" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="HeroIconActiveBrush" Color="#18181B" />

        <!-- Monochrome Squircle Icon Tiles -->
        <SolidColorBrush x:Key="SquircleBgBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="SquircleBorderBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="SquircleIconBrush" Color="#F4F4F5" />

        <!-- Status Capsule Brushes -->
        <SolidColorBrush x:Key="StatusCapsuleBgBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="StatusCapsuleBorderBrush" Color="#00000000" />
        <SolidColorBrush x:Key="StatusCapsuleTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="StatusDotBrush" Color="#FFFFFF" />

        <!-- Keycap Chip Brushes -->
        <SolidColorBrush x:Key="KeycapBgBrush" Color="#27272A" />
        <SolidColorBrush x:Key="KeycapBorderBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="KeycapTextBrush" Color="#F4F4F5" />

        <!-- Bottom Status / Notification Box Brushes (Monochrome Theme) -->
        <SolidColorBrush x:Key="WarningBgBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#25FFFFFF" />
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#45FFFFFF" />
        <SolidColorBrush x:Key="ScrollBarThumbDragBrush" Color="#70FFFFFF" />

        <!-- ========================================== -->
        <!-- Windows 11 Native Caption Buttons          -->
        <!-- ========================================== -->
        <Style x:Key="Win11MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <Path x:Name="minLine"
                                  Width="10" Height="10"
                                  Data="M 0,5 L 10,5"
                                  Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                  StrokeThickness="1.2"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="0,20,0,0">
                            <Path x:Name="cross"
                                  Width="10" Height="10"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                  StrokeThickness="1.2"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123" />
                                <Setter TargetName="cross" Property="Stroke" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C4101E" />
                                <Setter TargetName="cross" Property="Stroke" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Theme Toggle Button Style -->
        <Style x:Key="TitleThemeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================== -->
        <!-- CHUNKY LIQUID GLASS TOGGLE SWITCH (52x30)  -->
        <!-- ========================================== -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="52" Height="30" SnapsToDevicePixels="True">
                            <!-- Liquid Glass Track & Recessed Trench -->
                            <Border x:Name="track"
                                    Width="52" Height="30"
                                    Background="{DynamicResource ToggleOffBrush}"
                                    BorderBrush="{DynamicResource ToggleOffBorderBrush}"
                                    BorderThickness="1.2"
                                    CornerRadius="15">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glow" BlurRadius="7" ShadowDepth="2" Direction="270" Opacity="0" Color="{DynamicResource AccentColor}" />
                                </Border.Effect>
                                <!-- Trench Depth & Refraction Overlay (Physical Overhead Lighting) -->
                                <Grid>
                                    <Border Height="8" VerticalAlignment="Top" CornerRadius="14,14,0,0" Opacity="0.30">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#40000000" Offset="0.0" />
                                                <GradientStop Color="#00000000" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Height="4" VerticalAlignment="Bottom" CornerRadius="0,0,14,14" Opacity="0.22">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Crystal Droplet Knob with Hardware-Accelerated Fluid Motion -->
                            <Border x:Name="knob"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource ToggleKnobBrush}"
                                    BorderBrush="{DynamicResource ToggleKnobBorderBrush}"
                                    BorderThickness="0.8"
                                    HorizontalAlignment="Left"
                                    Margin="3,3,0,3"
                                    Cursor="Hand">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="knobTrans" X="0" />
                                        <ScaleTransform x:Name="knobScale" ScaleX="1.0" ScaleY="1.0" CenterX="12" CenterY="12" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1.8" Direction="270" Opacity="0.30" Color="Black" />
                                </Border.Effect>
                                <!-- Overhead Specular Crescent Highlight -->
                                <Border Height="5" Margin="4,1.5,4,0" VerticalAlignment="Top" CornerRadius="2.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#F0FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource ToggleOnBorderBrush}" />
                                <Setter TargetName="knob" Property="Background" Value="{DynamicResource ToggleKnobActiveBrush}" />
                                <Setter TargetName="knob" Property="BorderBrush" Value="{DynamicResource ToggleKnobActiveBorderBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knobTrans"
                                                             Storyboard.TargetProperty="X"
                                                             To="22"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="knobScale" Storyboard.TargetProperty="ScaleX">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.09" Value="1.15" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.00" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.22"
                                                             Duration="0:0:0.20" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knobTrans"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="knobScale" Storyboard.TargetProperty="ScaleX">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.09" Value="1.15" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.00" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.20" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Hover Bounce Interaction matching OSD Slider -->
                            <Trigger SourceName="knob" Property="IsMouseOver" Value="True">

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knobScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.10"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="knobScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.10"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knobScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.00"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="knobScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.00"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================== -->
        <!-- LIQUID GLASS OSD DURATION SLIDER           -->
        <!-- ========================================== -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" ClipToBounds="False">
                            <Track x:Name="PART_Track" ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Background="{DynamicResource SliderTrackBrush}"
                                                        BorderBrush="{DynamicResource SliderTrackBorderBrush}"
                                                        BorderThickness="0.8"
                                                        CornerRadius="4,0,0,4">
                                                    <!-- Liquid Specular Sheen -->
                                                    <Border Height="3" Margin="2,1,0,0" VerticalAlignment="Top" CornerRadius="1.5,0,0,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#80FFFFFF" Offset="0.0" />
                                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Background="{DynamicResource SliderTrackEmptyBrush}"
                                                        BorderBrush="{DynamicResource SliderTrackBorderBrush}"
                                                        BorderThickness="0.8"
                                                        CornerRadius="0,4,4,0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <!-- Crystal Bead Thumb with Liquid Specular Rim -->
                                                    <Border x:Name="thumbCircle"
                                                            Width="18" Height="18"
                                                            CornerRadius="9"
                                                            Background="{DynamicResource SliderThumbBgBrush}"
                                                            BorderBrush="{DynamicResource SliderThumbBorderBrush}"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.3" Color="Black" />
                                                        </Border.Effect>
                                                        <!-- Top Specular Crescent Highlight -->
                                                        <Border Height="4" Margin="3,1,3,0" VerticalAlignment="Top" CornerRadius="2">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#E0FFFFFF" Offset="0.0" />
                                                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter TargetName="thumbCircle" Property="Width" Value="20" />
                                                        <Setter TargetName="thumbCircle" Property="Height" Value="20" />
                                                        <Setter TargetName="thumbCircle" Property="CornerRadius" Value="10" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbCircle" Property="Width" Value="20" />
                                                        <Setter TargetName="thumbCircle" Property="Height" Value="20" />
                                                        <Setter TargetName="thumbCircle" Property="CornerRadius" Value="10" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================== -->
        <!-- LIQUID LENS MUTE BUTTON                    -->
        <!-- ========================================== -->
        <Style x:Key="MicToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="rootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="gridScale" ScaleX="1.0" ScaleY="1.0" />
                            </Grid.RenderTransform>

                            <!-- Dynamic Ambient Halo (Physically Offset Downward from Overhead Light) -->
                            <Ellipse x:Name="glow"
                                     Width="98" Height="98"
                                     Opacity="0.45"
                                     Margin="0,5,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.40" GradientOrigin="0.5,0.30" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#40FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#15FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Outer Jewel-Cut Glass Bevel Ring (Physically Grounded Downward Contact Shadow) -->
                            <Border x:Name="outerJewelRing"
                                    Width="86" Height="86"
                                    CornerRadius="43"
                                    BorderBrush="{DynamicResource JewelRingBorderBrush}"
                                    BorderThickness="1.5"
                                    Background="{DynamicResource JewelRingBgBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.38" Color="Black" />
                                </Border.Effect>
                            </Border>

                            <!-- Inner Fluid Refraction Lens Core -->
                            <Border x:Name="lens"
                                    Width="68" Height="68"
                                    CornerRadius="34"
                                    BorderBrush="#85FFFFFF"
                                    BorderThickness="1">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.35,0.25" GradientOrigin="0.35,0.25" RadiusX="0.65" RadiusY="0.65">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#FFE4E4E7" Offset="0.45" />
                                        <GradientStop Color="#FFD4D4D8" Offset="0.85" />
                                        <GradientStop Color="#FFA1A1AA" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <!-- Overhead Specular Curved Glass Highlight -->
                                    <Ellipse Width="44" Height="18"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             Margin="0,3,0,0">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#C8FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#40FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Razor-Sharp Vector Microphone Cutout Matching App Logo (app.ico) -->
                                    <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="iconPath"
                                              Fill="{DynamicResource HeroIconActiveBrush}"
                                              Stretch="Uniform"
                                              Width="32" Height="32"
