                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextWhiteBrush}"
                                                 CaretBrush="{DynamicResource TextWhiteBrush}"
                                                 BorderThickness="0"
                                                 FontSize="10.5"
                                                 FontWeight="Bold"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Padding="0"
                                                 LostFocus="TxtSoundVolume_LostFocus"
                                                 KeyDown="TxtSoundVolume_KeyDown"
                                                 TextChanged="TxtSoundVolume_TextChanged" />
                                        <TextBlock Grid.Column="1"
                                                   Text=" %"
                                                   Foreground="{DynamicResource TextGrayBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="1,0,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                            <!-- Row 3: Run on Windows Startup -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="7"
                                        Background="{DynamicResource SquircleBgBrush}"
                                        BorderBrush="{DynamicResource SquircleBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center">
                                    <Path Data="M13 10V3L4 14h7v7l9-11h-7z"
                                          Fill="{DynamicResource SquircleIconBrush}"
                                          Stretch="Uniform"
                                          Width="12" Height="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Run on Windows Startup" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Launch automatically with Windows" Foreground="{DynamicResource TextGrayBrush}" FontSize="9.5" />
                                </StackPanel>

                                <CheckBox x:Name="cbStartup"
                                          Grid.Column="2"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="CbStartup_Checked"
                                          Unchecked="CbStartup_Unchecked" />
                            </Grid>

                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                            <!-- Row 4: Start Minimized -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="7"
                                        Background="{DynamicResource SquircleBgBrush}"
                                        BorderBrush="{DynamicResource SquircleBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center">
                                    <Path Data="M19 13l-7 7-7-7m14-8l-7 7-7-7"
                                          Stroke="{DynamicResource SquircleIconBrush}"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Start Minimized" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Always hide main window to tray" Foreground="{DynamicResource TextGrayBrush}" FontSize="9.5" />
                                </StackPanel>

                                <CheckBox x:Name="cbStartMinimized"
                                          Grid.Column="2"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="CbStartMinimized_Checked"
                                          Unchecked="CbStartMinimized_Unchecked" />
                            </Grid>

                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,8" />

                            <!-- Row 5: Run as Administrator -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="7"
                                        Background="{DynamicResource SquircleBgBrush}"
                                        BorderBrush="{DynamicResource SquircleBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center">
                                    <Path Data="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                          Stroke="{DynamicResource SquircleIconBrush}"
                                          StrokeThickness="1.4"
                                          Stretch="Uniform"
                                          Width="13" Height="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Run as Administrator" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Enables hotkeys over anti-cheat and elevated windows"
                                               Foreground="{DynamicResource TextGrayBrush}"
                                               FontSize="9.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <CheckBox x:Name="cbRunAsAdmin"
                                          Grid.Column="2"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="CbRunAsAdmin_Checked"
                                          Unchecked="CbRunAsAdmin_Unchecked" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hidden legacy checkbox to preserve settings binding -->
                    <CheckBox x:Name="cbLightMode" Visibility="Collapsed" />

                    <!-- GROUP 3: Settings Location & Data (iOS Inset Squircle Group) -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Row 1: Header with Label and Icon -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Standard 28x28 Squircle Tile -->
                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="7"
                                        Background="{DynamicResource SquircleBgBrush}"
                                        BorderBrush="{DynamicResource SquircleBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center">
                                    <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                          Fill="{DynamicResource SquircleIconBrush}"
                                          Stretch="Uniform"
                                          Width="13" Height="11"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Settings Location"
                                               Foreground="{DynamicResource TextWhiteBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Configuration file and data directory"
                                               Foreground="{DynamicResource TextGrayBrush}"
                                               FontSize="9.5" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: 3 Action Buttons in an evenly spaced horizontal row under the text -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="btnOpenFolder" Content="Open"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Height="26" FontSize="10.5" HorizontalAlignment="Stretch"
                                        Click="BtnOpenDataFolder_Click" />
                                <Button Grid.Column="2" x:Name="btnChangeFolder" Content="Change"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Height="26" FontSize="10.5" HorizontalAlignment="Stretch"
                                        Click="BtnChangeDataFolder_Click" />
                                <Button Grid.Column="4" x:Name="btnResetData" Content="Reset"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Height="26" FontSize="10.5" HorizontalAlignment="Stretch"
                                        Click="BtnResetSettings_Click" />
                            </Grid>

                            <!-- Clean Separator -->
                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,10,0,8" />

                            <!-- Row 2: Inset Glass Pill for Full Path Display -->
                            <Border Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="tbStoragePath"
                                               Text="%APPDATA%\MicMute"
                                               Foreground="{DynamicResource TextGrayBrush}"
                                               FontSize="10"
                                               FontFamily="Consolas, SF Mono, Cascadia Mono, Segoe UI Mono, monospace"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Warning / Notification Box -->
                    <Border x:Name="borderWarning"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningBgBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,7"
                            Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Squircle Tile matching the rest of the application -->
                            <Border x:Name="borderWarningIcon"
                                    Grid.Column="0"
                                    Width="24" Height="24"
                                    CornerRadius="6"
                                    Background="{DynamicResource SquircleBgBrush}"
                                    BorderBrush="{DynamicResource SquircleBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="pathWarningIcon"
                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Fill="{DynamicResource SquircleIconBrush}"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <TextBlock x:Name="tbWarningMessage"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
