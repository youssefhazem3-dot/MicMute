<Window x:Class="MicMute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Mute"
        Width="350"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Dynamic Theme Brushes -->
        <Color x:Key="AccentColor">#155A84</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#297FB8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A297FB8" />
        <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EB141E2D" Offset="0.0" />
            <GradientStop Color="#EB0A0F19" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="TitleBarBgBrush" Color="#00000000" />
        <SolidColorBrush x:Key="TitleTextBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TextGrayBrush" Color="#86868B" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#86868B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#32FFFFFF" />
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#636366" />
        <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#8E8E93" />
        <LinearGradientBrush x:Key="RecordGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A0B3E0F7" Offset="0.0" />
            <GradientStop Color="#A081B4D6" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RecordGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C04AB2EB" Offset="0.0" />
            <GradientStop Color="#C01D78A8" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="WarningBgBrush" Color="#1AFF453A" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#1AFFFFFF" />

        <!-- Windows 11 Style Minimize Caption Button -->
        <Style x:Key="Win11MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <Path Data="M 0,5 L 10,5"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Style Close Caption Button with Red Hover -->
        <Style x:Key="Win11CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="0,20,0,0">
                            <Path x:Name="cross"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123" />
                                <Setter TargetName="cross" Property="Stroke" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C4101E" />
                                <Setter TargetName="cross" Property="Stroke" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Style Smooth Toggle Switch -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" SnapsToDevicePixels="True">
                            <Border x:Name="track"
                                    Background="{DynamicResource ToggleOffBrush}"
                                    BorderBrush="{DynamicResource ToggleOffBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glow" BlurRadius="6" ShadowDepth="0" Opacity="0" Color="{DynamicResource AccentColor}" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="knob"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,2,0,2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="22,2,0,2"
                                                                Duration="0:0:0.15">
                                                <ThicknessAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="2,2,0,2"
                                                                Duration="0:0:0.15">
                                                <ThicknessAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Harmonized Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TextWhiteBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextWhiteBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Margin="2,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          TextBlock.Foreground="{DynamicResource TextWhiteBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                TextElement.Foreground="{DynamicResource TextWhiteBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding Path=SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding Path=SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextBlock.Foreground="{DynamicResource TextWhiteBrush}"
                                                                  VerticalAlignment="Center" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextWhiteBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=toggle}"
                                        MaxHeight="200"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.35" Color="Black" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style with Perfect Circular Radial Glow Halo -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" ClipToBounds="False">
                            <Track x:Name="PART_Track" ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{DynamicResource BorderBrush}" CornerRadius="0,2,2,0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                                                                                                                                                <Track.Thumb>
                                    <Thumb Width="16" Height="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <!-- Solid Accent Thumb (No White Ring, No Glow) -->
                                                    <Ellipse x:Name="thumbCircle"
                                                             Width="13" Height="13"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter TargetName="thumbCircle" Property="Width" Value="15" />
                                                        <Setter TargetName="thumbCircle" Property="Height" Value="15" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbCircle" Property="Width" Value="15" />
                                                        <Setter TargetName="thumbCircle" Property="Height" Value="15" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big Mic Toggle Button Style -->
        <Style x:Key="MicToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="glow"
                                     Width="88" Height="88"
                                     Fill="#0091FF"
                                     Opacity="0.3"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="5" />
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Border Width="82" Height="82"
                                    CornerRadius="41"
                                    BorderBrush="#801A5C80"
                                    BorderThickness="1.2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFA8D5F0" Offset="0.0" />
                                        <GradientStop Color="#FF6B9EC0" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="Black" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="lens"
                                    Width="62" Height="62"
                                    CornerRadius="31"
                                    BorderBrush="#80FFFFFF"
                                    BorderThickness="1">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#FFEBF5FA" Offset="0.0" />
                                        <GradientStop Color="#FF90BCDB" Offset="0.75" />
                                        <GradientStop Color="#FF4A82A6" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="iconPath"
                                      Fill="#164B6E"
                                      Stretch="Uniform"
                                      Width="21" Height="21"
                                      Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z" />
                                <Line x:Name="slashBg"
                                      X1="3" Y1="3" X2="23" Y2="23"
                                      Stroke="#FFFCE4EC"
                                      StrokeThickness="4.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <Line x:Name="slash"
                                      X1="3" Y1="3" X2="23" Y2="23"
                                      Stroke="#E53935"
                                      StrokeThickness="2.0"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="iconPath" Property="Fill" Value="#164B6E" />
                                <Setter TargetName="glow" Property="Fill" Value="#0091FF" />
                                <Setter TargetName="slashBg" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="slash" Property="Visibility" Value="Collapsed" />
                            </Trigger>

                            <Trigger Property="Tag" Value="Muted">
                                <Setter TargetName="lens" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#FFFCE4EC" Offset="0.0" />
                                            <GradientStop Color="#FFF48FB1" Offset="0.75" />
                                            <GradientStop Color="#FFE91E63" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="iconPath" Property="Fill" Value="#880E4F" />
                                <Setter TargetName="glow" Property="Fill" Value="#FF453A" />
                                <Setter TargetName="slashBg" Property="Visibility" Value="Visible" />
                                <Setter TargetName="slash" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="glow">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.1" To="0.65"
                                                         Duration="0:0:1.6"
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="glow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.95" To="1.1"
                                                         Duration="0:0:1.6"
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="glow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.95" To="1.1"
                                                         Duration="0:0:1.6"
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Record Glass Button Style -->
        <Style x:Key="RecordGlassButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TextWhiteBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outerBorder"
                                Background="{DynamicResource RecordGlassBrush}"
                                BorderBrush="{DynamicResource RecordGlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17"
                                Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="Black" />
                            </Border.Effect>
                            <Border x:Name="innerBorder"
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style -->
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextWhiteBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Window Border -->
    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar with Windows 11 Native Caption Controls -->
            <Border x:Name="borderTitleBar" Grid.Row="0"
                    Background="{DynamicResource TitleBarBgBrush}"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Left: App Icon & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0">
                        <Image Source="app.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Mic Mute"
                                   Foreground="{DynamicResource TitleTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Windows 11 Minimize & Close Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="btnMinimize" Style="{StaticResource Win11MinimizeButtonStyle}" ToolTip="Minimize" Click="MinimizeButton_Click" />
                        <Button x:Name="btnClose" Style="{StaticResource Win11CloseButtonStyle}" ToolTip="Close" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="16,0,16,16">
                <!-- Big Central Button & Status -->
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,14">
                    <Button x:Name="btnStateToggle"
                            Style="{StaticResource MicToggleButtonStyle}"
                            Tag="Active"
                            Click="BtnStateToggle_Click" />

                    <TextBlock x:Name="tbStatusText"
                               Text="A C T I V E"
                               Foreground="#00A3FF"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="10.5"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="statusGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.9" Color="#00A3FF" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Section 1: Microphone Selection (Harmonized Borders) -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                  Fill="{DynamicResource TextGrayBrush}"
                                  Stretch="Uniform"
                                  Width="12.5" Height="13.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Microphone Selection"
                                       Foreground="{DynamicResource TextWhiteBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox x:Name="cbDevices"
                                  Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextWhiteBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section 2: Shortcut Key -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M19,10H5V8H19V10M19,13H5V11H19V13M19,16H5V14H19V16Z"
                                  Fill="{DynamicResource TextGrayBrush}"
                                  Stretch="Uniform"
                                  Width="13" Height="9"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Shortcut Key"
                                       Foreground="{DynamicResource TextWhiteBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="borderHotkey"
                                    Grid.Column="0"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,6">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glowHotkey" BlurRadius="6" ShadowDepth="0" Opacity="0" Color="{DynamicResource AccentColor}" />
                                </Border.Effect>
                                <TextBlock x:Name="tbHotkey"
                                           Text="F1"
                                           Foreground="{DynamicResource TextWhiteBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Button x:Name="btnRecordHotkey"
                                    Grid.Column="1"
                                    Content="Record"
                                    Style="{StaticResource RecordGlassButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="BtnRecordHotkey_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Preferences / Settings Card -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <!-- OSD Option -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="On-Screen Display (OSD)" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Show visual popup when toggled" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="cbEnableOsd"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="CbEnableOsd_Checked"
                                      Unchecked="CbEnableOsd_Unchecked" />
                        </Grid>

                        <!-- OSD Duration Slider -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duration" Foreground="{DynamicResource TextGrayBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="sliderOsdDuration"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.1" Maximum="30.0"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="SliderOsdDuration_ValueChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4,1">
                                    <TextBox x:Name="txtOsdDuration"
                                             Width="32"
                                             Text="1.5"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextWhiteBrush}"
                                             BorderThickness="0"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             TextAlignment="Right"
                                             VerticalAlignment="Center"
                                             LostFocus="TxtOsdDuration_LostFocus"
                                             KeyDown="TxtOsdDuration_KeyDown"
                                             TextChanged="TxtOsdDuration_TextChanged" />
                                </Border>
                                <TextBlock Text=" s" Foreground="{DynamicResource TextGrayBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" />

                        <!-- Run on Startup Option -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Run on Windows Startup" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Launch minimized in system tray" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="cbStartup"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="CbStartup_Checked"
                                      Unchecked="CbStartup_Unchecked" />
                        </Grid>

                        <!-- Start Minimized Option -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Minimized" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Always hide main window at startup" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="cbStartMinimized"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="CbStartMinimized_Checked"
                                      Unchecked="CbStartMinimized_Unchecked" />
                        </Grid>

                        <!-- Light Mode Option -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Light Mode" Foreground="{DynamicResource TextWhiteBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Use light theme instead of dark slate" Foreground="{DynamicResource TextGrayBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="cbLightMode"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="CbLightMode_Checked"
                                      Unchecked="CbLightMode_Unchecked" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Data & Storage Location -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                  Fill="{DynamicResource TextGrayBrush}"
                                  Stretch="Uniform"
                                  Width="13" Height="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Data &amp; Storage Location"
                                       Foreground="{DynamicResource TextWhiteBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,8">
                            <TextBlock x:Name="tbStoragePath"
                                       Text="%APPDATA%\MicMute"
                                       Foreground="{DynamicResource TextGrayBrush}"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="btnOpenFolder" Content="Open Folder"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="BtnOpenDataFolder_Click" />

                            <Button Grid.Column="2"
                                    x:Name="btnChangeFolder" Content="Change..."
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="BtnChangeDataFolder_Click" />

                            <Button Grid.Column="4"
                                    x:Name="btnResetData" Content="Reset Data"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="BtnResetSettings_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

