<Window x:Class="MicMute.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD"
        Width="140"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <Border x:Name="borderPanel"
                Background="#E50F141C"
                BorderBrush="#94A3B8"
                BorderThickness="1.5"
                CornerRadius="70">
            <Border.Effect>
                <DropShadowEffect x:Name="osdShadow"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.45"
                                  Color="#94A3B8" />
            </Border.Effect>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" Height="64">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Active Microphone Icon in Neutral White-Grey / Slate aesthetic -->
                    <Grid x:Name="pathActive" Width="40" Height="40" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="activeGlyph" Fill="#E2E8F0"
                              Stretch="Uniform"
                              Width="32"
                              Height="32"
                              Data="M12,2.5 C9.93,2.5 8.25,4.18 8.25,6.25 L8.25,10.5 C8.25,12.57 9.93,14.25 12,14.25 C14.07,14.25 15.75,12.57 15.75,10.5 L15.75,6.25 C15.75,4.18 14.07,2.5 12,2.5 Z M6,7.5 C6,6.95 6.45,6.5 7,6.5 C7.55,6.5 8,6.95 8,7.5 L8,10.5 C8,12.71 9.79,14.5 12,14.5 C14.21,14.5 16,12.71 16,10.5 L16,7.5 C16,6.95 16.45,6.5 17,6.5 C17.55,6.5 18,6.95 18,7.5 L18,10.5 C18,13.48 15.82,15.96 13,16.42 L13,19.5 L15.5,19.5 C16.05,19.5 16.5,19.95 16.5,20.5 C16.5,21.05 16.05,21.5 15.5,21.5 L8.5,21.5 C7.95,21.5 7.5,21.05 7.5,20.5 C7.5,19.95 7.95,19.5 8.5,19.5 L11,19.5 L11,16.42 C8.18,15.96 6,13.48 6,10.5 Z" />
                    </Grid>
                    <!-- Muted Microphone Icon with Chill Low-Light Red styling -->
                    <Grid x:Name="pathMuted" Width="40" Height="40" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="mutedGlyph" Fill="#E28585"
                              Stretch="Uniform"
                              Width="32"
                              Height="32"
                              Data="M12,2.5 C9.93,2.5 8.25,4.18 8.25,6.25 L8.25,10.5 C8.25,12.57 9.93,14.25 12,14.25 C14.07,14.25 15.75,12.57 15.75,10.5 L15.75,6.25 C15.75,4.18 14.07,2.5 12,2.5 Z M6,7.5 C6,6.95 6.45,6.5 7,6.5 C7.55,6.5 8,6.95 8,7.5 L8,10.5 C8,12.71 9.79,14.5 12,14.5 C14.21,14.5 16,12.71 16,10.5 L16,7.5 C16,6.95 16.45,6.5 17,6.5 C17.55,6.5 18,6.95 18,7.5 L18,10.5 C18,13.48 15.82,15.96 13,16.42 L13,19.5 L15.5,19.5 C16.05,19.5 16.5,19.95 16.5,20.5 C16.5,21.05 16.05,21.5 15.5,21.5 L8.5,21.5 C7.95,21.5 7.5,21.05 7.5,20.5 C7.5,19.95 7.95,19.5 8.5,19.5 L11,19.5 L11,16.42 C8.18,15.96 6,13.48 6,10.5 Z" />
                        <Line X1="4" Y1="4" X2="36" Y2="36" Stroke="#60000000" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line x:Name="muteSlash" X1="4" Y1="4" X2="36" Y2="36" Stroke="#E28585" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock x:Name="tbStatus"
                               Text="MUTED"
                               Foreground="#E28585"
                               FontSize="10.5"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
